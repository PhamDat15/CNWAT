{
    "name": "kma/contacts-laravel",
    "type": "project",
    "description": "Ứng dụng Quản lý Danh bạ (Contacts) sử dụng framework Laravel - Học phần Công Nghệ Web An Toàn",
    "keywords": ["laravel", "contacts", "kma", "security"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
